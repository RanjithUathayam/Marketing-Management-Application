# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info

# ── MSSQL ────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MarketingManagement
DB_USER=sa
DB_PASSWORD=change-me
# Named instance (e.g. SQLEXPRESS) — leave blank when using DB_PORT
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=20

# ── Auth ─────────────────────────────────────────────────
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# true only in development: returns the OTP in the API response instead of needing an SMS gateway
OTP_DEV_ECHO=true
# SMS / WhatsApp gateway (leave blank to log OTPs to the server log)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# ── Business settings ────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
LATE_AFTER=10:00
TAX_RATE=0.05
GEOFENCE_METERS=50
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
